---
/** Retail-panel style header row: label · centred two-line heading · label, thin rule beneath. */
import XText from './XText.astro';
interface Props { left: string[]; right: string[]; lines: string[]; size?: 1 | 2 | 3; as?: 'h1' | 'h2' | 'h3'; ghost?: string; id?: string }
const { left, right, lines, size = 2, as = 'h2', ghost, id } = Astro.props;
---
<header class="drow">
  <p class="drow__side body-bold" aria-hidden="true">{left.map(l => <span>{l}</span>)}</p>
  <XText lines={lines} size={size} as={as} ghost={ghost} id={id} class="drow__title" />
  <p class="drow__side drow__side--r body-bold">{right.map(l => <span>{l}</span>)}</p>
  <svg class="drow__rule" viewBox="0 0 1000 6" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 3 C 160 1.4, 330 4.4, 500 3 S 840 1.6, 1000 3" stroke="currentColor" stroke-width="1.2" fill="none" vector-effect="non-scaling-stroke" />
  </svg>
</header>

<style>
  .drow {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
    padding-bottom: 28px; position: relative; isolation: isolate; text-align: center;
  }
  .drow__side { margin: 0; color: var(--accent-label, var(--fg)); display: flex; flex-direction: column; gap: 2px; text-align: left; }
  .drow__side--r { text-align: right; align-items: flex-end; }
  .drow__rule { grid-column: 1 / -1; width: 100%; height: 6px; margin-top: 16px; opacity: 0.55; }
  @media (max-width: 767px) {
    .drow { grid-template-columns: 1fr 1fr; }
    .drow :global(.drow__title) { grid-column: 1 / -1; grid-row: 1; }
    .drow__side { grid-row: 2; }
  }
</style>
