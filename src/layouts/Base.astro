---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, META } from '../lib/site';

interface Props { title: string; description?: string; ogImage?: string; bodyClass?: string; teamColor?: string; chrome?: boolean }
const {
  title,
  description = 'Every NBA player in the 2026-27 season, rated out of 100 from NBA.com data: 80% statistics, 20% skills, ranked by team, conference, league and position.',
  ogImage = 'og/default.png',
  bodyClass = '',
  teamColor,
  chrome = true,
} = Astro.props;
const fullTitle = title === 'Notturno' ? 'Notturno — NBA Ratings 2026-27' : `${title} — Notturno NBA Ratings`;
const ogUrl = new URL(url(ogImage), Astro.site).href;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8" />
  <!-- resizes-visual: the on-screen keyboard overlays the page instead of shrinking the layout (Chromium/Android) -->
  <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-visual" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1d1d1d" />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Allura&family=Limelight&family=Manrope:wght@300;400;600&family=M+PLUS+Rounded+1c:wght@800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Allura&family=Limelight&family=Manrope:wght@300;400;600&family=M+PLUS+Rounded+1c:wght@800&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Allura&family=Limelight&family=Manrope:wght@300;400;600&family=M+PLUS+Rounded+1c:wght@800&display=swap" /></noscript>
  <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  <script is:inline>
    // --svh: a viewport-height unit that ignores the on-screen keyboard. It only updates when the width
    // changes (rotation, window resize), never on height-only changes, so opening the keyboard on a phone
    // can't collapse the page height and throw the reader to a different place.
    (function () {
      var root = document.documentElement, w = innerWidth;
      var set = function () { root.style.setProperty('--svh', innerHeight / 100 + 'px'); };
      set();
      var check = function () { if (innerWidth !== w) { w = innerWidth; set(); } };
      addEventListener('resize', check);
      addEventListener('orientationchange', function () { setTimeout(check, 350); }); // a real rotation changes the width
    })();
  </script>
  <slot name="head" />
</head>
<body class={bodyClass} style={teamColor ? `--team:${teamColor}` : undefined}>
  <a class="skip-link" href="#main">Skip to content</a>
  <!-- hand-drawn stroke: displaces straight borders by a pixel or two -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <filter id="wobble" x="-5%" y="-20%" width="110%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  {chrome && <Header />}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  {chrome && <Footer />}
  <div class="spill" aria-hidden="true"><span data-spill></span></div>

  <style>
    .spill { position: fixed; right: 8px; top: 12vh; bottom: 12vh; width: 5px; z-index: 30; pointer-events: none; }
    .spill span {
      position: absolute; left: 0; width: 5px; height: 110px; border-radius: 4px; background: var(--accent);
      transform: translateY(calc(var(--sp, 0) * (76vh - 110px))); transition: background 0.4s;
    }
    :global(body.paper-zone) .spill span { background: var(--ink); }
    #main:focus { outline: none; }
  </style>

  <script>
    // word reveals
    const io = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('[data-xtext]').forEach(el => io.observe(el));

    // scroll pill
    const pill = document.querySelector<HTMLElement>('[data-spill]');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      pill?.style.setProperty('--sp', String(max > 0 ? Math.min(1, scrollY / max) : 0));
    };
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // "Last updated" in the visitor's local time; refresh from meta.json in case the page is cached
    const fmt = (iso: string) => new Date(iso).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
    const paint = (iso: string) => document.querySelectorAll<HTMLTimeElement>('[data-updated]').forEach(t => { t.dateTime = iso; t.textContent = fmt(iso); });
    const first = document.querySelector<HTMLTimeElement>('[data-updated]')?.dateTime;
    if (first) paint(first);
    const base = ((b: string) => (b.endsWith('/') ? b : b + '/'))(import.meta.env.BASE_URL);
    fetch(base + 'data/meta.json', { cache: 'no-cache' })
      .then(r => r.json()).then(m => m.lastUpdated && paint(m.lastUpdated)).catch(() => {});
  </script>
</body>
</html>
